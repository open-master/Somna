# =============================================================
#  Somna AI — .env.example
#  用法: cp .env.example .env  然后填入各家 API KEY
#  所有服务通过 docker compose env_file 共用这一个文件
# =============================================================

# -------------------- Runtime --------------------
ENV=dev
DOMAIN=localhost
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# -------------------- Postgres (Agent 状态 + pgvector + LiteLLM 日志) --------------------
POSTGRES_USER=somna
POSTGRES_PASSWORD=somna_pw_change_me
POSTGRES_DB=somna
POSTGRES_URL=postgresql://somna:somna_pw_change_me@postgres:5432/somna

# -------------------- MySQL (业务库) --------------------
MYSQL_ROOT_PASSWORD=mysql_root_change_me
MYSQL_USER=somna
MYSQL_PASSWORD=mysql_pw_change_me
MYSQL_DATABASE=somna_biz
# 容器互联仍用 mysql:3306；此处仅映射到宿主机，与本机已装的 MySQL 冲突时改成 3307 等
MYSQL_HOST_PORT=3306
MYSQL_URL=mysql://somna:mysql_pw_change_me@mysql:3306/somna_biz

# -------------------- Milvus (向量库) --------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
# Milvus 内置 MinIO（docker-compose 中 milvus-minio；与业务 MinIO/S3 无关）
# 须与 Mem0/pymilvus 无关，仅向量文件落盘；生产请改为强随机并与 milvus 数据卷一致迁移
# 从旧版 compose（曾硬编码 minioadmin）升级且沿用原数据卷时，可保持 minioadmin / minioadmin，直至按需重建卷
MILVUS_MINIO_ACCESS_KEY=milvus_minio_access_change_me
MILVUS_MINIO_SECRET_KEY=milvus_minio_secret_change_me

# -------------------- Redis --------------------
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# -------------------- Object Storage (MinIO) --------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_access
S3_SECRET_KEY=minio_secret_change_me
S3_BUCKET=somna
S3_REGION=us-east-1

# -------------------- Event Bus --------------------
NATS_URL=nats://nats:4222

# -------------------- Temporal --------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=somna-session
# Activity 心跳/总时长/重试：见 apps/agent-core/app/temporal/workflow_limits.py（改后需重建 agent-core）

# -------------------- LiteLLM Gateway --------------------
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-local-master-change-me
LITELLM_DATABASE_URL=postgresql://somna:somna_pw_change_me@postgres:5432/litellm
# LiteLLM 写库模型（STORE_MODEL_IN_DB）：全新 Postgres 实例必须允许迁移。
# false=每次启动会做结构检查（首次建表）；库表已就绪后改为 true 可缩短 litellm 启动时间。
DISABLE_LITELLM_SCHEMA_UPDATE=false

# -------------------- Model Provider API Keys --------------------
# Moonshot (Kimi K2)
MOONSHOT_API_KEY=

# DashScope (Qwen3)
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 硅基流动 SiliconFlow (bge-m3 embedding / bge-reranker)
SILICONFLOW_API_KEY=

# 可选：真 Claude 兜底
ANTHROPIC_API_KEY=

# 可选：OpenAI
OPENAI_API_KEY=

# -------------------- Agent Core --------------------
# Anthropic SDK → LiteLLM 根地址（/v1/messages，别名路由）；勿用 .../anthropic（直通 api.anthropic.com）
ANTHROPIC_BASE_URL=http://litellm:4000
ANTHROPIC_AUTH_TOKEN=sk-local-master-change-me

# JWT：访问令牌。浏览器侧由 Next 写成 HttpOnly Cookie（JS 不可读）。生产务必改为强随机串
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_HOURS=168

# ==================== 邮件 SMTP（注册/登录验证码）====================
# 163：465(SSL) 或 587(STARTTLS)；填充 SMTP_PASSWORD（多为「客户端授权码」）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Google 登录（后端校验 id_token）；前端构建需 NEXT_PUBLIC_GOOGLE_CLIENT_ID（可与下项同值）
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 逗号分隔：首次注册或谷歌自动建号时记为 admin，否则为 user
ADMIN_EMAILS=

# -------------------- 积分与任务计费 --------------------
# 套餐每日/月度额度（修改后重启 agent-core；已持有余额在下一次日/月重置时更新）
PLAN_FREE_DAILY=10
PLAN_BASIC_DAILY=20
PLAN_PRO_DAILY=50
PLAN_FREE_MONTHLY=50
PLAN_BASIC_MONTHLY=200
PLAN_PRO_MONTHLY=500

# 任务基础分：.env 是默认值，管理员运行时配置可覆盖
POINTS_TASK_CHAT_BASE=1
POINTS_TASK_RESEARCH_BASE=2
POINTS_TASK_CONTENT_BUILD_BASE=4
POINTS_TASK_CODE_BUILD_BASE=5
POINTS_TASK_OPERATE_BASE=3
POINTS_TASK_MEDIA_BASE=1
POINTS_TASK_MODEL_RESERVE=2
POINTS_EFFORT_LOW_MULTIPLIER=1
POINTS_EFFORT_MEDIUM_MULTIPLIER=2
POINTS_EFFORT_HIGH_MULTIPLIER=4

# 模型资源换算：全任务聚合后向上取整
POINTS_MODEL_INPUT_TOKENS_PER_POINT=8000
POINTS_MODEL_OUTPUT_TOKENS_PER_POINT=2000

# 成功发生的付费能力
POINTS_WEB_SEARCH_BATCH=1
POINTS_VISUAL_CRITIQUE=2
POINTS_IMAGE_PER_OUTPUT=8
POINTS_TTS_PER_1000_CHARS=2
POINTS_VIDEO_DEFAULT_PER_OUTPUT=40
POINTS_EXTERNAL_SIDE_EFFECT=1
POINTS_RESERVATION_TTL_SECONDS=7200

# 业务语义别名（LiteLLM 里做 group alias 映射）
AGENT_DEFAULT_PLANNER=agent-planner
AGENT_DEFAULT_TASKFRAME=agent-taskframe
AGENT_DEFAULT_EXECUTOR=agent-executor
AGENT_DEFAULT_CODER=agent-coder
AGENT_DEFAULT_REASONER=agent-reasoner
AGENT_DEFAULT_LONGCTX=agent-longctx
# visual_critique、wan_text2image、wan_t2v / wan_i2v / wan_r2v / wan_video_edit、minimax_tts：未传工具参数 model 时 agent-core 回退（与前端「MCP 工具」页一致可改）
AGENT_DEFAULT_VISUAL_CRITIQUE=qwen3-vl-plus
AGENT_DEFAULT_MCP_WAN_T2I=wan2.2-t2i-flash
AGENT_DEFAULT_MCP_WAN_T2V=wan2.2-t2v-plus
AGENT_DEFAULT_MCP_WAN_I2V=happyhorse-1.0-i2v
AGENT_DEFAULT_MCP_WAN_R2V=wan2.7-r2v
AGENT_DEFAULT_MCP_WAN_VIDEO_EDIT=wan2.7-videoedit
AGENT_DEFAULT_MCP_MINIMAX_TTS=speech-2.6-hd
AGENT_COMPACT_MODEL=agent-cheap
AGENT_EMBED_MODEL=agent-embed
AGENT_RERANK_MODEL=agent-rerank

# 同一 run_id 跨 reflect 累计的最大工具调用轮数
AGENT_MAX_TURNS=40
# 同一 run_id 跨 execute / delivery retry 累计的最大模型或 SDK Agent turn 数
AGENT_MAX_TOTAL_TURNS=80
# 同一 run_id 的 executor 模型累计输入+输出 token 上限
AGENT_MAX_TOTAL_TOKENS=500000
AGENT_COMPACT_TOKEN_THRESHOLD=80000

# -------------------- mem0 --------------------
MEM0_LLM_PROVIDER=litellm
MEM0_LLM_BASE_URL=http://litellm:4000
MEM0_LLM_MODEL=agent-cheap
MEM0_EMBEDDER_MODEL=agent-embed
MEM0_VECTOR_STORE=milvus
MEM0_COLLECTION=mem0_memories

# -------------------- 搜索工具 --------------------
# Brave Web Search: https://api-dashboard.search.brave.com（请求头 X-Subscription-Token）
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=

# -------------------- MCP Hub --------------------
MCP_HUB_URL=http://mcp-hub:8090
# agent-core 与 mcp-hub 共用。空值时工具 API 返回 503。`make env` 会在为空时自动生成。
MCP_HUB_INTERNAL_TOKEN=
# 搜索：duckduckgo 无需 Key；出网失败时默认返回错误（不再静默 mock）。仅开发可设 MCP_SEARCH_HTTP_ERROR_FALLBACK_MOCK=true
# 要稳定真搜索：BRAVE_SEARCH_API_KEY + MCP_SEARCH_PROVIDER=brave，或 TAVILY/SERPER
MCP_SEARCH_PROVIDER=duckduckgo    # brave | duckduckgo | ddg | tavily | serper | mock
MCP_SEARCH_HTTP_ERROR_FALLBACK_MOCK=false
# 容器出网到 Brave/DDG 失败时，填本机代理（Clash 等常为本机 7890/7891）
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# Brave 总超时（秒，含建连+读）
# MCP_BRAVE_TIMEOUT_SEC=60
MCP_SHELL_TIMEOUT_SEC=60
MCP_SHELL_MAX_TIMEOUT_SEC=600
MCP_SHELL_PREVIEW_BYTES=4096
MCP_FS_MAX_FILE_BYTES=268435456    # 256 MiB（沙盒 read/write 上限；视频预览需覆盖常见成片体积，可按需再调大）
MCP_FS_MAX_LIST_ENTRIES=2000

# -------------------- 生成式媒体（MCP Hub 内置工具）--------------------
# 万相文生图 / 文生图：使用上方 DASHSCOPE_API_KEY；HTTP 域须与 Key 地域一致（北京示例如下）
# MCP_DASHSCOPE_HTTP_BASE=https://dashscope.aliyuncs.com/api/v1
# MCP_DASHSCOPE_HTTP_BASE=https://dashscope-intl.aliyuncs.com/api/v1   # 新加坡
MCP_WAN_T2I_MODEL=wan2.2-t2i-flash
MCP_WAN_T2V_MODEL=wan2.2-t2v-plus
MCP_WAN_I2V_MODEL=happyhorse-1.0-i2v
MCP_WAN_R2V_MODEL=wan2.7-r2v
MCP_WAN_VIDEO_EDIT_MODEL=wan2.7-videoedit
# 轮询任务间隔（秒）与最长等待（秒；视频生成可能数分钟）
MCP_WAN_POLL_INTERVAL_SEC=3
MCP_WAN_POLL_TIMEOUT_SEC=600
MCP_WAN_REQUEST_TIMEOUT_SEC=120

# 视觉/版式审美评审（mcp-hub `visual_critique`；百炼 OpenAI 兼容，复用 DASHSCOPE_API_KEY）
# MCP_VISUAL_CRITIQUE_MODEL=qwen3-vl-plus
# MCP_VISUAL_CRITIQUE_MODEL=qwen3-vl-flash
# MCP_VISUAL_CRITIQUE_OPENAI_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MCP_VISUAL_CRITIQUE_TIMEOUT_SEC=120
# MCP_VISUAL_CRITIQUE_MAX_IMAGE_BYTES=20971520

# MiniMax 语音合成（国内站 Key 配国内 Base；国际 Key 用 https://api.minimax.io）
MINIMAX_API_KEY=
MCP_MINIMAX_BASE_URL=https://api.minimaxi.com
MCP_MINIMAX_TTS_MODEL=speech-2.6-hd
MCP_MINIMAX_TTS_VOICE_ID=male-qn-qingse
MCP_MINIMAX_REQUEST_TIMEOUT_SEC=120

# -------------------- Observability --------------------
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=langfuse_pw_change_me
LANGFUSE_NEXTAUTH_SECRET=langfuse_nextauth_change_me
LANGFUSE_SALT=langfuse_salt_change_me
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# -------------------- Sandbox --------------------
SANDBOX_IMAGE=somna/sandbox:latest
SANDBOX_NETWORK=somna_sandbox_net
SANDBOX_CPU_LIMIT=2
SANDBOX_MEM_LIMIT=4g
SANDBOX_IDLE_TIMEOUT_SEC=1800
SANDBOX_WORKSPACE_VOLUME=somna_sandbox_workspace

# -------------------- Auth (Better-Auth) --------------------
AUTH_SECRET=change-me-32bytes-random-string
AUTH_URL=http://localhost:3000
# 生产：若使用 docker-compose.nginx.yml + HTTPS，改为公网根地址，例如 https://somna-ai.com（与浏览器一致）

# -------------------- Nginx + Let's Encrypt（叠加 docker-compose.nginx.yml）--------------------
# 证书在容器内路径 /etc/letsencrypt/live/<TLS_DOMAIN>/ ，须与 certbot certonly 时 -d 的第一个域名一致
TLS_DOMAIN=somna-ai.com
CERTBOT_EMAIL=you@example.com

# -------------------- Frontend (Next.js 公开变量) --------------------
# 使用 docker compose 或 `next dev` + rewrites 直连 agent-core 时留空：浏览器与 artifact 链接均走同源 /api/v1（含 SSE）。
# 独立 BFF 时填公网可达前缀，例如 https://api.example.com（不要尾斜杠；将拼接 /v1/...）。
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=ws://localhost:8080
NEXT_PUBLIC_SANDBOX_BASE=ws://localhost:8100
NEXT_PUBLIC_APP_NAME=Somna
NEXT_PUBLIC_APP_LOCALE=zh-CN
