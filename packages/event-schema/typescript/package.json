{
  "name": "@somna/event-schema",
  "version": "0.1.0",
  "description": "Somna AI — Agent → UI event protocol (zod + TS types)",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dispatcher": {
      "types": "./src/dispatcher.ts",
      "default": "./src/dispatcher.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
